#!/bin/sh
# 双击 PlayGame.app 启动游戏；游戏退出后程序自己结束，不会留下终端窗口。
# 引擎查找走 tools/godot_env.sh；也支持在仓库根目录放一个 .godot_path 文件写引擎路径。
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
KEY_FILE="$APP_DIR/.godot_path"

if [ -z "$GODOT" ] && [ -f "$KEY_FILE" ]; then
	FROM_FILE="$(cat "$KEY_FILE")"
	[ -x "$FROM_FILE" ] && GODOT="$FROM_FILE"
fi

if ! . "$APP_DIR/tools/godot_env.sh"; then
	if command -v osascript >/dev/null 2>&1; then
		osascript -e 'display alert "找不到 Godot" message "请安装 Godot 4.7，或用 export GODOT=/path/to/godot 指定引擎路径。"' >/dev/null 2>&1
	fi
	exit 1
fi

cd "$APP_DIR" || exit 1

# Finder 会塞一个 -psn_xxx 参数给 app，Godot 不认，过滤掉
FILTERED=""
for a in "$@"; do
	case "$a" in
		-psn_*) ;;
		*) FILTERED="$FILTERED \"$a\"" ;;
	esac
done
eval "exec \"\$GODOT\" --path \"\$APP_DIR\" $FILTERED"
